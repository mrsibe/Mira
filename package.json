{
  "name": "mira-workspace",
  "private": true,
  "version": "0.0.5",
  "license": "MIT",
  "packageManager": "pnpm@11.1.3",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @mira/desktop dev",
    "build": "pnpm --filter @mira/desktop build",
    "preview": "pnpm --filter @mira/desktop preview",
    "tauri": "pnpm --filter @mira/desktop tauri",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "pnpm --filter @mira/desktop typecheck",
    "test": "pnpm --filter @mira/desktop test",
    "test:watch": "pnpm --filter @mira/desktop test:watch"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "globals": "16.5.0",
    "prettier": "^3.8.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.71.0"
  }
}
